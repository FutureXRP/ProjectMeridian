# MERIDIAN environment variables — copy to .env.local and fill in.
#
# RULE: every value here is SERVER-SIDE ONLY. Never prefix a secret with
# NEXT_PUBLIC_ (that would ship it to the browser). All third-party calls are
# made from server routes / server components and cached; keys never reach the
# client. See the whitepaper §5 ("No client-side secret exposure").

# --- Prediction-market sources ---
# Read-only market data is PUBLIC on both venues (no key needed). A Kalshi key
# is only required for authenticated endpoints / the WebSocket feed, which v1
# does not use. Leave blank unless/until needed.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# --- External reference anchors ---
# CME FedWatch / econ-calendar source (provider TBD).
FEDWATCH_API_KEY=
ECON_CALENDAR_API_KEY=

# --- AI layer (per-market reads + post drafting; language only) ---
ANTHROPIC_API_KEY=

# --- Supabase (Postgres: resolved-market history, calibration fits, posts) ---
# Server-side only. Do NOT expose the service-role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
